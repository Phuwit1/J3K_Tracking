generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Status {
  id        Int         @id @default(autoincrement())
  parcelId  Int        // Reference ID (No FK)
  status    ParcelStatus
  updatedAt DateTime    @default(now())
  updatedBy String?
  location  String?
}

enum ParcelStatus {
  PENDING
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
}
